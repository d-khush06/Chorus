# Chorus Verification MCP — Required Environment Variables
#
# Copy this file to .env and fill in your real values.
# Never commit the .env file to source control (it is already in .gitignore).
#
# Load at server startup with:
#   export $(grep -v '^#' .env | xargs)   # bash
# Or use a library such as `python-dotenv` to auto-load.

# ── YouTube Data API v3 ───────────────────────────────────────────────────────
# Obtain at: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: YouTube Data API v3
YOUTUBE_API_KEY=YOUR_YOUTUBE_DATA_API_V3_KEY_HERE

# ── Google Fact Check Tools API ───────────────────────────────────────────────
# Obtain at: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Fact Check Tools API
FACTCHECK_API_KEY=YOUR_FACTCHECK_TOOLS_API_KEY_HERE

# ── Serper Web Search API ─────────────────────────────────────────────────────
# Obtain at: https://serper.dev (free tier: 2 500 searches/month)
SERPER_API_KEY=YOUR_SERPER_API_KEY_HERE

# ── Google Custom Search API (used by reverse_search_frame) ──────────────────
# Obtain at: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Custom Search JSON API
GOOGLE_CSE_API_KEY=YOUR_GOOGLE_CUSTOM_SEARCH_API_KEY_HERE

# ── Google Custom Search Engine ID ───────────────────────────────────────────
# Create at: https://programmablesearchengine.google.com
# Set the engine to search the entire web (not a specific site).
GOOGLE_CSE_CX=YOUR_CUSTOM_SEARCH_ENGINE_ID_HERE

# ── Optional: provider overrides ─────────────────────────────────────────────
# Controls which backend is used for reverse-image search (default: google_lens)
# REVERSE_SEARCH_PROVIDER=google_lens

# Controls which backend is used for web search (default: serper)
# WEB_SEARCH_PROVIDER=serper
