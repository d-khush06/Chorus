PORT=5000
SESSION_SECRET=your_session_secret
JWT_SECRET=your_jwt_secret
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/chorus

# Optional OAuth keys
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# ── RTSP / CCTV Configuration ────────────────────────────────────────────────

# Allowed private RTSP camera targets (CIDRs or IPs, comma-separated, or * for all)
# Used for cameras on the SAME local network (e.g. 192.168.x.x)
ALLOWED_RTSP_TARGETS=10.0.0.0/8,192.168.0.0/16,172.16.0.0/12,127.0.0.1,localhost

# ALLOW_PUBLIC_RTSP=true enables connecting to CCTV cameras over the INTERNET
# (different network / remote location) via:
#   - Public static IP:    rtsp://<public-ip>:<port>/stream
#   - DDNS hostname:       rtsp://myhome.ddns.net:554/stream
#   - Secure RTSP (TLS):   rtsps://camera.example.com:322/live
#   - Cloudflare Tunnel:   rtsp://<tunnel-url>/stream
#   - ngrok tunnel:        rtsp://<id>.tcp.ngrok.io:<port>/live
#
# WARNING: Only enable this if you trust the target camera URL.
# The SSRF guard still blocks all other non-RTSP schemes.
ALLOW_PUBLIC_RTSP=false

# Optional: MediaMTX / RTSP relay host (default: localhost)
# RTSP_RELAY_HOST=localhost
# MEDIAMTX_HOST=localhost
