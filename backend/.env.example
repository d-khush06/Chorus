PORT=5000
SESSION_SECRET=your_session_secret
JWT_SECRET=your_jwt_secret
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/chorus

# Optional OAuth keys
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# ── RTSP / CCTV Configuration ────────────────────────────────────────────────

# Cameras on the SAME local network — list allowed private CIDRs/IPs
# SECURITY: Never commit real camera credentials (IPs, usernames, passwords) to source control.
ALLOWED_RTSP_TARGETS=192.168.1.50,10.0.0.99

# ── Scenario A: Camera on mobile hotspot / different network ─────────────────
#
# Option 1 — Cloudflare Quick Tunnel (FREE, no account needed)
#   On the device sharing the hotspot with the camera, run:
#     cloudflared tunnel --url http://<camera-ip>:<hls-port>
#   Then paste the generated https://*.trycloudflare.com URL into Chorus.
#   No extra env vars needed — Cloudflare domains are auto-trusted.
#
# Option 2 — ngrok TCP tunnel
#   ngrok tcp 554     # then use rtsp://x.tcp.ngrok.io:<port>/stream in Chorus
#   No extra env vars needed — ngrok domains are auto-trusted.
#
# Option 3 — Public IP / DDNS (camera forwarded to internet)
#   Set ALLOW_PUBLIC_RTSP=true below, then use rtsp://<public-ip>:554/stream
#
ALLOW_PUBLIC_RTSP=false

# ── Scenario B: Public IP or DDNS camera ─────────────────────────────────────
# Set ALLOW_PUBLIC_RTSP=true to connect cameras via:
#   - Public static IP:  rtsp://203.x.x.x:554/stream
#   - DDNS hostname:     rtsp://myhome.ddns.net:554/cam1
#   - Secure RTSP (TLS): rtsps://camera.example.com:322/live
#
# WARNING: Trusted tunnel domains (Cloudflare, ngrok) are ALWAYS allowed.
# This flag only affects direct public IP / DDNS connections.
# ALLOW_PUBLIC_RTSP=false

# ── Optional: Local MediaMTX relay ───────────────────────────────────────────
# RTSP_RELAY_HOST=localhost
# MEDIAMTX_HOST=localhost
